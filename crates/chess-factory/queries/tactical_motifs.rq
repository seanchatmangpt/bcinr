# tactical_motifs.rq — one row per cf:TacticalMotif with every field the
# tactical_motif.rs.tera template consumes. Drives a fanout rule
# (output_file = "src/motifs/{{name}}.rs"): each row renders one motif file.
# ORDER BY ?id for deterministic, stable output (GGEN determinism law).
#
# PROVISION LAW (GGEN-TPL-001): template references only id, name, lowering,
# primitive, inputMask, eventCode, eventName, authority, doc, kernelHelpers,
# detectBody, firedBody, oracleBody.

PREFIX cf:   <https://bcinr.dev/chess-factory/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?id ?name ?lowering ?primitive ?inputMask
       ?eventCode ?eventName ?authority ?doc
       ?kernelHelpers ?detectBody ?firedBody ?oracleBody
WHERE {
    ?motif a cf:TacticalMotif ;
        cf:id          ?id ;
        cf:name        ?name ;
        cf:lowering    ?loweringNode ;
        cf:primitive   ?primitive ;
        cf:inputMask   ?inputMask ;
        cf:eventCode   ?eventCode ;
        cf:eventName   ?eventName ;
        cf:authority   ?authority ;
        cf:doc         ?doc ;
        cf:kernelHelpers ?kernelHelpers ;
        cf:detectBody    ?detectBody ;
        cf:firedBody     ?firedBody ;
        cf:oracleBody    ?oracleBody .
    ?loweringNode rdfs:label ?lowering .
}
ORDER BY ?id
