{# patterns_mod.rs.tera — renders src/patterns/mod.rs from pattern_index.rq.

   Emits, by iterating rows ordered by id: (1) `pub mod <name>;` declarations, (2)
   `pub use <name>::<name>;` re-exports, and (3) the `PATTERN_REGISTRY` slice of PatternSpec.
   Object kinds arrive as parallel comma-joined `row.objectCodes` / `row.objectNames`; the
   `zip`/`split` Tera helpers below expand them into `ObjectKind { code, name }` literals.
   The output carries the GENERATED banner; the committed mod.rs is the offline source of
   truth.
#}
// GENERATED BY ggen — DO NOT EDIT. Source: ggen/schema/patterns.ttl + ggen/queries/pattern_index.rq.
// Regenerate: `ggen sync`.

//! Generated branchless pattern kernels.
//!
//! GENERATED SURFACE: produced by `ggen sync` and committed for offline builds.

use crate::class::status;
use crate::ir::{
    AdmissionRule, EventKind, LoweringKind, ObjectKind, PatternId, PatternSpec,
};

// --- Kernel modules (ordered by pattern id) ---
{% for row in results %}
pub mod {{ row.name }};
{%- endfor %}

// --- Kernel re-exports ---
{% for row in results %}
pub use {{ row.name }}::{{ row.name }};
{%- endfor %}

/// The standard admission contract used by every pattern.
const STD_ADMISSION: AdmissionRule = AdmissionRule {
    required_status: status::ADMITTED,
    refusal_status: status::REFUSED,
};

/// The catalog of all generated patterns as data. Iterated by [`crate::verify`].
pub static PATTERN_REGISTRY: &[PatternSpec] = &[
{%- for row in results %}
    PatternSpec {
        id: PatternId({{ row.id }}),
        name: "{{ row.name }}",
        lowering: LoweringKind::{{ row.lowering }},
        state_card: {{ row.stateCard }},
        event: EventKind { code: {{ row.eventCode }}, name: "{{ row.eventName }}" },
        objects: &[
        {%- set codes = row.objectCodes | split(pat=",") -%}
        {%- set names = row.objectNames | split(pat=",") -%}
        {%- for code in codes %}
            ObjectKind { code: {{ code }}, name: "{{ names[loop.index0] }}" },
        {%- endfor %}
        ],
        admission: STD_ADMISSION,
        otel_span: {{ row.otelSpan }},
    },
{%- endfor %}
];
