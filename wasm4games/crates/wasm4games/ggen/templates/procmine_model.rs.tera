// GENERATED BY ggen — DO NOT EDIT. Source: ggen/schema/chains.ttl + ggen/schema/patterns.ttl.
// Regenerate: `ggen sync` (rule `procmine_model`, query chain_models.rq + template
// procmine_model.rs.tera). Joins each ch:ChainStep -> ch:pattern -> w4g:id, ordered by
// (chainName, stepIndex), so each chain's `activities` is its declared process model.

//! The normative process model: each JTBD chain as an ordered activity sequence.
//!
//! A [`ChainModel`] is the *de jure* model in process-mining terms — the prescribed order
//! of activities (pattern ids) that a conforming trace must reproduce. [`CHAIN_MODELS`] is
//! the committed projection of `chains.ttl`, ordered by chain name so the table is stable
//! across regenerations.

/// One JTBD chain expressed as an ordered activity sequence (the declared model order).
///
/// `activities[i]` is the [`crate::ir::PatternId`] raw code of step `i + 1` (the kernel that
/// `ggen` resolved from the chain's `ch:pattern` at that `ch:stepIndex`). `golden` is the
/// chain's `ch:golden` composition digest, reused as a per-chain anchor so a model edit and a
/// composition-oracle edit move together.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct ChainModel {
    /// Stable 1-based chain id (position in [`CHAIN_MODELS`], ordered by chain name).
    pub chain_id: u16,
    /// The chain's snake_case name (matches `ch:name` in `chains.ttl`).
    pub name: &'static str,
    /// The 8 ordered activity (pattern-id) codes — the declared model order.
    pub activities: [u16; 8],
    /// The chain's `ch:golden` FNV-1a composition digest (mirrors the chain test `GOLDEN`).
    pub golden: u64,
}

impl ChainModel {
    /// The declared activity sequence as a slice.
    #[inline]
    #[must_use = "returns the model's activity order; bind or compare it"]
    pub fn activities(&self) -> &[u16] {
        &self.activities
    }
}

/// All 8 JTBD chains, ordered by chain name. The single source of normative model order.
///
/// GENERATED from `chains.ttl`; every `activities` entry is a valid id present in
/// [`crate::patterns::PATTERN_REGISTRY`] (asserted by the module tests).
pub static CHAIN_MODELS: &[ChainModel] = &[
{% for row in results %}
    ChainModel {
        chain_id: {{ loop.index }},
        name: "{{ row.chainName }}",
        activities: [{{ row.activityIds }}],
        golden: {{ row.golden }},
    },
{% endfor %}
];
