@prefix bc:   <https://bcinr.dev/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

################################################################################
# Numeric profile and policy constants.
#
# Mathematical domain, backend representation, and executable envelope are
# distinct. A mathematically meaningful request outside the Q16.16 envelope is
# refused as NumericRangeExceeded; it is never reclassified as invalid math.
################################################################################

bc:Q16_16 a bc:NumericProfile ;
    rdfs:label "Q16.16" ;
    bc:profileDoc "Unsigned 32-bit fixed point, 16 fractional bits." .

bc:FractionalBits a bc:ProfileConstant ;
    bc:constName "Q16_16_FRACTIONAL_BITS" ; bc:constType "u32" ; bc:constValue "16" ;
    bc:inProfile bc:Q16_16 ;
    bc:derivationOf "Definitional: the representation is Q16.16." .

bc:EscortDynamicRange a bc:ProfileConstant ;
    bc:constName "ESCORT_DYNAMIC_RANGE_LIMIT" ; bc:constType "i32" ; bc:constValue "16" ;
    bc:inProfile bc:Q16_16 ;
    bc:derivationOf "For max-shift escort weights, the largest exponent is zero. Q16.16 retains a positive least weight only while max(q*log2(m))-min(q*log2(m)) is at most 16. The envelope is therefore a sibling-group property, not a scalar q or m limit." .

bc:MaxLensMagnitude a bc:ProfileConstant ;
    bc:constName "MAX_LENS_MAGNITUDE" ; bc:constType "u32" ; bc:constValue "2" ;
    bc:inProfile bc:Q16_16 ;
    bc:derivationOf "The admitted CMCA mathematical lens domain is q in [-2,2]. Analysis and certified implementations must expose the same domain even when one implementation could execute more loop iterations." .

bc:TranscendentalErrorUlps a bc:ProfileConstant ;
    bc:constName "TRANSCENDENTAL_MAX_ERROR_ULPS" ; bc:constType "u32" ; bc:constValue "4" ;
    bc:inProfile bc:Q16_16 ;
    bc:derivationOf "The fixed-bit log2/exp2 round-trip falsifier covers the admitted clipped mass endpoints and representative powers; four output ulps includes two one-ulp transcendental roundings plus composition rounding." .

bc:AllocationOperationBudget a bc:ProfileConstant ;
    bc:constName "ALLOCATION_ERROR_OPERATION_BUDGET" ; bc:constType "u32" ; bc:constValue "1024" ;
    bc:inProfile bc:Q16_16 ;
    bc:derivationOf "The bounded N=8,K=4,Q=4 allocator executes fewer than 1024 value-affecting fixed-point operations on any output path. Multiplying by TRANSCENDENTAL_MAX_ERROR_ULPS produces a conservative per-output comparison interval without a free floating tolerance." .

bc:MaxCycleUnroll a bc:ProfileConstant ;
    bc:constName "MAX_CYCLE_UNROLL" ; bc:constType "usize" ; bc:constValue "2" ;
    bc:policyMarked true ;
    bc:policyOwner "bcinr-powl::language" ;
    bc:policyRationale "Bounded language enumeration policy. Complete equivalence requires the separate unbounded automata-product verifier; this value never upgrades bounded agreement to theorem standing." .
