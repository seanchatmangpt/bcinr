PREFIX bc:   <https://bcinr.dev/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# Every case of every closed taxonomy, denormalised with its taxonomy so a
# single flat result set can drive one generic template.
#
# Optional facts are emitted as COMPLETE rendered fragments, empty when absent,
# never as a bare value the template has to test. A template that asks "is this
# non-empty?" is deciding, and a decision in a template is unreviewable: it does
# not appear in the graph, no gate can reach it, and it silently changes what is
# emitted. Binding the whole block here keeps the template a substitution, which
# is what makes template correctness reduce to query correctness.
#
# `is_first` / `is_last` remain, and they are the one impurity left here: they
# exist only because a flat result set is being asked to drive a nested
# structure, so the template must still ask "is this row a boundary?". The fix
# is to change the SHAPE this query returns, not to dress up the flags -- until
# then they stay, because removing them without changing the shape emits a file
# with no enums in it at all.
SELECT ?taxonomy ?taxonomy_doc ?case_name ?case_order ?case_doc
       ?coverage_gap_block ?case_gap_block ?is_first ?is_last
WHERE {

    ?tax a bc:ClosedTaxonomy ;
         rdfs:label     ?taxonomy ;
         bc:taxonomyDoc ?taxonomy_doc .

    ?case a bc:TaxonCase ;
          bc:inTaxonomy ?tax ;
          bc:caseName   ?case_name ;
          bc:caseOrder  ?case_order ;
          bc:caseDoc    ?case_doc .

    # A closed taxonomy's completeness is not decidable from inside: nothing in
    # our own code can tell us a variant is missing. A mature reference
    # implementation's closed enum IS the specification's variant set,
    # empirically -- so the gap is a set difference against theirs, and it is
    # recorded here rather than left as an open worry.
    OPTIONAL { ?tax  bc:referenceCoverageGap ?declared_gap . }
    OPTIONAL { ?case bc:referenceCoverageGap ?declared_case_gap . }
    BIND(COALESCE(?declared_gap,      "") AS ?coverage_gap)
    BIND(COALESCE(?declared_case_gap, "") AS ?case_gap)

    # The doc block, not the raw text: absent gap yields the empty string, so the
    # template emits it unconditionally either way.
    BIND(IF(?coverage_gap = "", "",
            CONCAT("///\n/// # Known coverage gap\n///\n/// ", ?coverage_gap, "\n"))
         AS ?coverage_gap_block)

    BIND(IF(?case_gap = "", "",
            CONCAT("    ///\n    /// Known coverage gap: ", ?case_gap, "\n"))
         AS ?case_gap_block)

    BIND(NOT EXISTS {
        ?e bc:inTaxonomy ?tax ; bc:caseOrder ?eo . FILTER(?eo < ?case_order)
    } AS ?is_first)

    BIND(NOT EXISTS {
        ?l bc:inTaxonomy ?tax ; bc:caseOrder ?lo . FILTER(?lo > ?case_order)
    } AS ?is_last)
}
ORDER BY ?taxonomy xsd:integer(?case_order)
