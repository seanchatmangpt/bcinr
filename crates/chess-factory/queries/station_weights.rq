# station_weights.rq — one row per cf:FeatureStation projecting its Q8.8
# aggregation weight. Static single-file rule -> src/weights.rs: the template
# iterates `sparql_results` to emit the STATION_WEIGHTS_Q8 table (indexed by
# station id) consumed by the branchless aggregator. ORDER BY ?id so the table
# index matches the station ordinal (determinism + correctness).
#
# PROVISION LAW (GGEN-TPL-001): template references only id, name, weight_q8.

PREFIX cf: <https://bcinr.dev/chess-factory/ontology#>

SELECT ?id ?name ?weight_q8
WHERE {
    ?station a cf:FeatureStation ;
        cf:id        ?id ;
        cf:name      ?name ;
        cf:weight_q8 ?weight_q8 .
}
ORDER BY ?id
