{#- benchmark_matrix.json.tera — renders schema/benchmark_matrix.json from
    benchmark_matrix.rq.

    STATIC single-file rule: ggen renders this ONCE with the full row list bound
    as `sparql_results`. Emits the opponent x budget cross product the
    `bcinr_benchmark` runner sweeps to measure Elo(tau).

    PROVISION LAW (GGEN-TPL-001): every row.* below is projected by
    benchmark_matrix.rq: oid, oname, okind, opath, ogo, otier, ocalib, oinst,
    bid, bname, bmicros, gocell. Rows arrive ORDER BY oid, bmicros (determinism).

    go_command is row.gocell — the per-(opponent,budget) effective go-line (the
    BudgetCommand override, or the opponent default when no override exists).
    default_go_command records the opponent default for audit.
-#}
{
  "schema": "bcinr.chess-factory.benchmark_matrix.v1",
  "doc": "Manufactured from ontology/benchmark.ttl. First-class source (GGEN-SRC law): edit the TTL, never this JSON.",
  "cell_count": {{ sparql_results | length }},
  "cells": [
{%- for row in sparql_results %}
    {
      "opponent_id": {{ row.oid }},
      "opponent": "{{ row.oname }}",
      "engine_kind": "{{ row.okind }}",
      "engine_path": "{{ row.opath }}",
      "go_command": "{{ row.gocell }}",
      "default_go_command": "{{ row.ogo }}",
      "tier": "{{ row.otier }}",
      "calibratable": {{ row.ocalib }},
      "installed": {{ row.oinst }},
      "budget_id": {{ row.bid }},
      "budget": "{{ row.bname }}",
      "budget_micros": {{ row.bmicros }}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
