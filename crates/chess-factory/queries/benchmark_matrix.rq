# benchmark_matrix.rq — the opponent x budget-tier cross product the
# `bcinr_benchmark` runner sweeps. One row per (opponent, budget) cell.
#
# STATIC single-file rule: the template iterates `sparql_results` to emit
# schema/benchmark_matrix.json. ORDER BY a stable composite key (opponent id,
# then budget micros) for deterministic, replayable output.
#
# PROVISION LAW (GGEN-TPL-001): template references only the columns projected
# here: oid, oname, okind, opath, ogo, otier, ocalib, oinst, bid, bname, bmicros,
# gocell (the per-(opponent,budget) effective go-command).
#
# gocell = the cf:BudgetCommand override for this (opponent, budget) cell when one
# exists, else the opponent's default cf:goCommand. This is what makes the budget
# columns drive DISTINCT search effort instead of a uniform `go depth 1`.

PREFIX cf: <https://bcinr.dev/chess-factory/ontology#>

SELECT ?oid ?oname ?okind ?opath ?ogo ?otier ?ocalib ?oinst ?bid ?bname ?bmicros ?gocell
WHERE {
    ?opp a cf:Opponent ;
        cf:id          ?oid ;
        cf:name        ?oname ;
        cf:engineKind  ?okind ;
        cf:enginePath  ?opath ;
        cf:goCommand   ?ogo ;
        cf:tier        ?otier ;
        cf:calibratable ?ocalib ;
        cf:installed   ?oinst .
    ?bud a cf:BudgetTier ;
        cf:id     ?bid ;
        cf:name   ?bname ;
        cf:micros ?bmicros .
    OPTIONAL {
        ?cmd a cf:BudgetCommand ;
            cf:forOpponent ?opp ;
            cf:forBudget   ?bud ;
            cf:goCommand   ?cmdgo .
    }
    BIND(COALESCE(?cmdgo, ?ogo) AS ?gocell)
}
ORDER BY ?oid ?bmicros
