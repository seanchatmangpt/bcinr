# station_index.rq — one row per cf:FeatureStation for the registry module
# (src/stations/mod.rs). Static single-file rule: the template iterates
# `sparql_results` to emit `pub mod <name>;`, flat re-exports, and the
# STATION_REGISTRY table. ORDER BY ?id for stable, deterministic output.
#
# PROVISION LAW (GGEN-TPL-001): template references only id, name, lowering,
# scoreScale, weight_q8, eventCode, eventName.

PREFIX cf:   <https://bcinr.dev/chess-factory/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?id ?name ?lowering ?scoreScale ?weight_q8 ?eventCode ?eventName
WHERE {
    ?station a cf:FeatureStation ;
        cf:id          ?id ;
        cf:name        ?name ;
        cf:lowering    ?loweringNode ;
        cf:scoreScale  ?scoreScale ;
        cf:weight_q8   ?weight_q8 ;
        cf:eventCode   ?eventCode ;
        cf:eventName   ?eventName .
    ?loweringNode rdfs:label ?lowering .
}
ORDER BY ?id
