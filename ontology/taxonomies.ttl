@prefix bc:   <https://bcinr.dev/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

################################################################################
# Closed taxonomies of the bcinr system.
#
# Every variant set that must be eliminated exhaustively lives here. One
# admitted fact per variant; the Rust enum, its ALL table, its name/doc/
# citation accessors and its exhaustive match arms are all manufactured.
#
# A taxonomy declared here but absent from the executable type -- or present in
# the type and absent here -- is a compile error at the classify tripwire, not
# a review item.
################################################################################

################################################################################
# PDDL 3.1 -- effect taxonomy
#
# `ground_v2.rs:767` drops Numeric/Timed/Forall/When through `_ => {}`, and
# `cognitive.rs:271` then derives causal independence over that shadow. Six
# admitted forms; nothing may silently handle five.
################################################################################

bc:PddlEffect a bc:ClosedTaxonomy ;
    rdfs:label "PddlEffect" ;
    bc:taxonomyDoc "The six effect forms PDDL 3.1 admits. An effect kind that cannot be represented downstream must refuse, never be dropped." ;
    bc:rustPath "wasm4pm_compat::pddl::PddlEffect" .

bc:Eff_Add a bc:TaxonCase ; bc:inTaxonomy bc:PddlEffect ; bc:caseOrder 0 ;
    bc:caseName "Add" ; bc:caseShape "tuple" ;
    bc:caseDoc "Add a ground atom to the state." ;
    bc:representableInStrips true .

bc:Eff_Del a bc:TaxonCase ; bc:inTaxonomy bc:PddlEffect ; bc:caseOrder 1 ;
    bc:caseName "Del" ; bc:caseShape "tuple" ;
    bc:caseDoc "Delete a ground atom from the state." ;
    bc:representableInStrips true .

bc:Eff_Numeric a bc:TaxonCase ; bc:inTaxonomy bc:PddlEffect ; bc:caseOrder 2 ;
    bc:caseName "Numeric" ; bc:caseShape "tuple" ;
    bc:caseDoc "Assign/increase/decrease/scale a numeric fluent." ;
    bc:representableInStrips false ;
    bc:lossRefusal "UnsupportedEffect" .

bc:Eff_Timed a bc:TaxonCase ;
    bc:referenceCoverageGap """VAL's time_spec (ptree.h:136) has five values: E_AT_START, E_AT_END, E_OVER_ALL, E_CONTINUOUS, E_AT. We consume three. E_CONTINUOUS (continuous effects) and E_AT (timed initial literals) are absent. Missing variants are a set difference against their enum.""" ;
    bc:coverageGapEvidence bc:EvidenceRead ; bc:inTaxonomy bc:PddlEffect ; bc:caseOrder 3 ;
    bc:caseName "Timed" ; bc:caseShape "tuple" ;
    bc:caseDoc "An effect scoped to at-start / at-end / over-all." ;
    bc:representableInStrips false ;
    bc:lossRefusal "TimedEffectUnsupported" .

bc:Eff_Forall a bc:TaxonCase ; bc:inTaxonomy bc:PddlEffect ; bc:caseOrder 4 ;
    bc:caseName "Forall" ; bc:caseShape "struct" ;
    bc:caseDoc "A quantified effect over a typed domain." ;
    bc:representableInStrips false ;
    bc:lossRefusal "UnsupportedEffect" .

bc:Eff_When a bc:TaxonCase ; bc:inTaxonomy bc:PddlEffect ; bc:caseOrder 5 ;
    bc:caseName "When" ; bc:caseShape "struct" ;
    bc:caseDoc "A conditional effect. Two actions conflicting only through a `when` are classified independent if this form is dropped." ;
    bc:representableInStrips false ;
    bc:lossRefusal "UnsupportedEffect" .

################################################################################
# PDDL 3.0 -- trajectory constraints
#
# `monitors.rs` implements five and silently no-ops the rest via
# `_ => monitor_state`. AtMostOnce's violation arm is unreachable and
# SometimeBefore's argument order is inverted.
################################################################################

bc:TrajectoryConstraint a bc:ClosedTaxonomy ;
    bc:referenceCoverageGap """VAL's constraint_sort (ptree.h:139) enumerates eleven sorts; this taxonomy has nine PDDL sorts plus the structural And. Missing: `at end` (E_ATEND, standard PDDL 3.0) and `after` (E_AFTER, a VAL extension). Missing variants are a set difference against their enum.""" ;
    bc:coverageGapEvidence bc:EvidenceRead ;
    rdfs:label "TrajectoryConstraint" ;
    bc:taxonomyDoc "PDDL 3.0 trajectory constraint forms. A monitor that cannot decide a form must refuse at admission, never no-op." ;
    bc:rustPath "wasm4pm_compat::pddl::TrajectoryConstraint" .

bc:Traj_Always a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 0 ;
    bc:caseName "Always" ; bc:caseShape "tuple" ;
    bc:caseDoc "Holds in every state of the trajectory, including the initial and final ones." ;
    bc:monitorSupported true ;
    bc:pendingAtFinalizeMeans "satisfied" ;
    bc:pendingRationale "Never reaches a terminal Satisfied; ending Pending means never falsified." .

bc:Traj_Sometime a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 1 ;
    bc:caseName "Sometime" ; bc:caseShape "tuple" ;
    bc:caseDoc "Holds in at least one state." ;
    bc:monitorSupported true ;
    bc:pendingAtFinalizeMeans "violated" ;
    bc:pendingRationale "Ending Pending means never witnessed." .

bc:Traj_AtMostOnce a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 2 ;
    bc:caseName "AtMostOnce" ; bc:caseShape "tuple" ;
    bc:caseDoc "Holds in at most one contiguous interval." ;
    bc:monitorSupported true ;
    bc:pendingAtFinalizeMeans "satisfied" ;
    bc:pendingRationale "Zero occurrences satisfies at-most-one. Current default of `violated` refuses valid plans." ;
    bc:absorbingOnSatisfied false ;
    bc:absorbingRationale "Satisfied is NOT terminal here: a second occurrence must still violate. The shared is_terminal() guard makes that arm unreachable." .

bc:Traj_SometimeBefore a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 3 ;
    bc:caseName "SometimeBefore" ; bc:caseShape "tuple" ;
    bc:caseDoc "(sometime-before phi psi): psi must hold strictly before any occurrence of phi. The FIRST argument is the triggered/later condition." ;
    bc:monitorSupported true ;
    bc:pendingAtFinalizeMeans "satisfied" ;
    bc:pendingRationale "If neither condition ever holds, the constraint is vacuously satisfied." ;
    bc:argumentOrderNote "create_monitor maps arg0 to condition_before, inverting the PDDL 3.0 reading." .

bc:Traj_SometimeAfter a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 4 ;
    bc:caseName "SometimeAfter" ; bc:caseShape "tuple" ;
    bc:caseDoc "(sometime-after phi psi): for all i, phi@i implies exists j>=i with psi@j." ;
    bc:monitorSupported true ;
    bc:pendingAtFinalizeMeans "satisfied" ;
    bc:pendingRationale "Vacuous universal: if phi never holds, satisfied." ;
    bc:absorbingOnSatisfied false ;
    bc:absorbingRationale "A later phi with no following psi must still violate." .

bc:Traj_Within a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 5 ;
    bc:caseName "Within" ; bc:caseShape "tuple" ;
    bc:caseDoc "Deadline over a timed trajectory." ;
    bc:monitorSupported false ;
    bc:unsupportedRefusal "UnsupportedTrajectoryConstraint" .

bc:Traj_AlwaysWithin a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 6 ;
    bc:caseName "AlwaysWithin" ; bc:caseShape "tuple" ;
    bc:caseDoc "Deadline following every trigger." ;
    bc:monitorSupported false ;
    bc:unsupportedRefusal "UnsupportedTrajectoryConstraint" .

bc:Traj_HoldDuring a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 7 ;
    bc:caseName "HoldDuring" ; bc:caseShape "tuple" ;
    bc:caseDoc "Holds across a bounded time window." ;
    bc:monitorSupported false ;
    bc:unsupportedRefusal "UnsupportedTrajectoryConstraint" .

bc:Traj_HoldAfter a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 8 ;
    bc:caseName "HoldAfter" ; bc:caseShape "tuple" ;
    bc:caseDoc "Holds from a time point onward." ;
    bc:monitorSupported false ;
    bc:unsupportedRefusal "UnsupportedTrajectoryConstraint" .

bc:Traj_And a bc:TaxonCase ; bc:inTaxonomy bc:TrajectoryConstraint ; bc:caseOrder 9 ;
    bc:caseName "And" ; bc:caseShape "tuple" ;
    bc:caseDoc "Conjunction; must be flattened before monitor construction." ;
    bc:monitorSupported false ;
    bc:unsupportedRefusal "flattened by flatten_trajectory_constraint" .

################################################################################
# Claim standing -- three hand-written 4-way classifications collapsed to one
#
# FormalStanding (contracts.rs), SemanticSupport (capability.rs) and
# procint:status all encode "never round up silently" separately.
################################################################################

bc:FormalStanding a bc:ClosedTaxonomy ;
    rdfs:label "FormalStanding" ;
    bc:taxonomyDoc "How much standing a claim has. Axiom-cleanliness is necessary, not sufficient: it cannot distinguish a proved theorem from a vacuous one." .

bc:Standing_Proven a bc:TaxonCase ; bc:inTaxonomy bc:FormalStanding ; bc:caseOrder 0 ;
    bc:caseName "Proven" ; bc:caseShape "unit" ;
    bc:caseDoc "Kernel-checked, sorry-free, axioms within the trusted set, and non-vacuity witnessed." ;
    bc:permitsOptimization true .

bc:Standing_Stated a bc:TaxonCase ; bc:inTaxonomy bc:FormalStanding ; bc:caseOrder 1 ;
    bc:caseName "Stated" ; bc:caseShape "unit" ;
    bc:caseDoc "Defined in Lean but not proven to have the properties a caller might assume." ;
    bc:permitsOptimization false .

bc:Standing_Vacuous a bc:TaxonCase ; bc:inTaxonomy bc:FormalStanding ; bc:caseOrder 2 ;
    bc:caseName "Vacuous" ; bc:caseShape "unit" ;
    bc:caseDoc "Typechecks and constrains nothing. `exists d, f 0 = d` holds of every f. Audits identically to a real theorem." ;
    bc:permitsOptimization false .

bc:Standing_Conjectural a bc:TaxonCase ; bc:inTaxonomy bc:FormalStanding ; bc:caseOrder 3 ;
    bc:caseName "Conjectural" ; bc:caseShape "unit" ;
    bc:caseDoc "A bare `def : Prop` with no proof attempted; the open goal its own authors name as such." ;
    bc:permitsOptimization false .

bc:Standing_Refuted a bc:TaxonCase ; bc:inTaxonomy bc:FormalStanding ; bc:caseOrder 4 ;
    bc:caseName "Refuted" ; bc:caseShape "unit" ;
    bc:caseDoc "A countermodel exists and is recorded: the claim is known false, not merely unproven." ;
    bc:permitsOptimization false .

bc:Standing_Blocked a bc:TaxonCase ; bc:inTaxonomy bc:FormalStanding ; bc:caseOrder 5 ;
    bc:caseName "Blocked" ; bc:caseShape "unit" ;
    bc:caseDoc "No proof and no formalized representation exists at all." ;
    bc:permitsOptimization false .

################################################################################
# Cascade refusals -- CMCA
################################################################################

bc:CascadeRefusal a bc:ClosedTaxonomy ;
    bc:isRefusalTaxonomy true ;
    rdfs:label "CascadeRefusal" ;
    bc:taxonomyDoc "Conditions under which the multifractal cascade has no correct answer. Each is a real condition, not a degradation." ;
    bc:rustPath "bcinr_cmca::cascade::CascadeRefusal" ;
    bc:runtimeCrate "bcinr_cmca" ;
    bc:rustFalsifierPrelude """use bcinr_cmca::cascade::{consequence_mass, CascadeTree}; use bcinr_cmca::fixed::NonNegativeFixed; let m = |v: f64| NonNegativeFixed::from_bits((v * 65536.0) as u32);""" ;
    bc:rustErrorPatternPrefix "Err(" ;
    bc:rustErrorPatternSuffix ")" .

bc:Casc_LengthMismatch a bc:TaxonCase ;
    bc:rustFalsifierExpr """CascadeTree::new(vec![None], vec![m(1.0), m(1.0)]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 0 ;
    bc:caseName "LengthMismatch" ; bc:caseShape "struct" ;
    bc:caseDoc "parent and mass vectors disagree in length." ; .

bc:Casc_ParentOutOfRange a bc:TaxonCase ;
    bc:rustFalsifierExpr """CascadeTree::new(vec![None, Some(9)], vec![m(1.0), m(1.0)]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 1 ;
    bc:caseName "ParentOutOfRange" ; bc:caseShape "struct" ;
    bc:caseDoc "A parent index addresses a node that does not exist." ;
    bc:falsifier "new(vec![Some(9)], vec![ONE])" .

bc:Casc_Cyclic a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![None, Some(2), Some(1)], vec![m(1.0), m(1.0), m(1.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[2]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 2 ;
    bc:caseName "Cyclic" ; bc:caseShape "struct" ;
    bc:caseDoc "The parent relation contains a cycle, so no hierarchy exists." ; .

bc:Casc_NoRoot a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![Some(0)], vec![m(1.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[2]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 3 ;
    bc:caseName "NoRoot" ; bc:caseShape "unit" ;
    bc:caseDoc "Every node has a parent, so there is nowhere for flow to enter." .

bc:Casc_ExponentOutOfRange a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![None, Some(0), Some(0)], vec![m(1.0), m(1.0), m(1.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[999]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 4 ;
    bc:caseName "ExponentOutOfRange" ; bc:caseShape "struct" ;
    bc:caseDoc "A lens exponent exceeds the admitted magnitude." .

bc:Casc_DegenerateSiblingSet a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![None, Some(0), Some(0)], vec![m(1.0), m(0.0), m(0.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[2]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 5 ;
    bc:caseName "DegenerateSiblingSet" ; bc:caseShape "struct" ;
    bc:caseDoc "All sibling escort weights are zero, so the normalizing sum vanishes. Fires only when ALL underflow; the mixed case is the dangerous one and does not refuse." .

bc:Casc_DegenerateSubtreeLeaves a bc:TaxonCase ;
    bc:falsifierUnwitnessedReason """Shadowed by DegenerateSiblingSet. Reaching it needs a node whose subtree-leaf weights all vanish while its own child weights do not, which forces an inner node whose children all vanish -- and the sibling check fires on that inner node first. May be unreachable; not asserted either way.""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 6 ;
    bc:caseName "DegenerateSubtreeLeaves" ; bc:caseShape "struct" ;
    bc:caseDoc "The flat path has no representable subtree-leaf weights." .

bc:Casc_ZeroMassUnderNegativeLens a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![None, Some(0), Some(0)], vec![m(1.0), m(0.0), m(1.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[-2]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 7 ;
    bc:caseName "ZeroMassUnderNegativeLens" ; bc:caseShape "struct" ;
    bc:caseDoc "m^q for m = 0 and q < 0 is undefined, not large." ; .

################################################################################
# WF-net -> POWL conversion refusals
################################################################################

bc:RefusalReason a bc:ClosedTaxonomy ;
    bc:isRefusalTaxonomy true ;
    rdfs:label "RefusalReason" ;
    bc:taxonomyDoc "Why Algorithm 3 declined a net. Each names the obligation actually checked -- not a paper result it does not discharge." ;
    bc:rustPath "bcinr_powl::wf_to_powl::RefusalReason" ;
    bc:runtimeCrate "bcinr_powl" ;
    bc:rustFalsifierPrelude """use bcinr_powl::wf_net::WfNet; use bcinr_powl::wf_to_powl::{convert, convert_and_verify, convert_with_budget}; let s = |x: &str| x.to_string();""" ;
    # RefusalReason is carried inside a `Refusal`, so the pattern that decides
    # "this input produced THIS refusal" has to reach through the wrapper.
    bc:rustErrorPatternPrefix "Err(bcinr_powl::wf_to_powl::Refusal { reason: " ;
    bc:rustErrorPatternSuffix ", .. })" .

bc:Ref_IrreducibleFragment a bc:TaxonCase ;
    bc:rustFalsifierSetup """let net = WfNet::new(["i","a","b","c","d","e","o"].map(s), [("t0",None),("t1",Some(s("A"))),("t2",Some(s("B"))),("t3",Some(s("C"))),("t4",None),("t5",None)].map(|(t,l)|(s(t),l)), [("i","t0"),("a","t1"),("b","t2"),("a","t3"),("b","t3"),("c","t4"),("d","t4"),("e","t5")].map(|(p,t)|(s(p),s(t))), [("t0","a"),("t0","b"),("t1","c"),("t2","d"),("t3","e"),("t4","o"),("t5","o")].map(|(t,p)|(s(t),s(p))), "i", "o").unwrap();""" ;
    bc:rustFalsifierExpr """convert(&net).map(|_| ())""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 0 ;
    bc:caseName "IrreducibleFragment" ; bc:caseShape "struct" ;
    bc:caseDoc "Our partitioner found no base case and no valid partition at this level -- Algorithm 3 line 25's FallThrough. It does NOT assert that no POWL structure exists: see bc:referenceDivergence." ;
    bc:referenceDivergence """The recorded witness is decomposed by the authors' reference implementation (seanchatmangpt/POWL, conversion/to_powl/from_pn), which returns a 2-node ChoiceGraph for it. So this refusal is a capability gap in our partition detection, not a property of the input. Reference `mine_partial_order` starts from the singleton partition and MERGES parts that conflict-hide, and `mine_choice_graph` is a separate detector; our sm/mg partition + progress guards reject cases both of theirs accept.""" ;
    bc:divergenceEvidence bc:EvidenceDifferential ; .

bc:Ref_BudgetExhausted a bc:TaxonCase ;
    bc:rustFalsifierSetup """let net = WfNet::new(["i","m","o"].map(s), [("t1",Some(s("A"))),("t2",Some(s("B")))].map(|(t,l)|(s(t),l)), [("i","t1"),("m","t2")].map(|(p,t)|(s(p),s(t))), [("t1","m"),("t2","o")].map(|(t,p)|(s(t),s(p))), "i", "o").unwrap();""" ;
    bc:rustFalsifierExpr """convert_with_budget(&net, 0).map(|_| ())""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 1 ;
    bc:caseName "BudgetExhausted" ; bc:caseShape "struct" ;
    bc:caseDoc "The bounded recursion budget ran out before termination." ;
    bc:falsifier "convert_with_budget(net_needing_one_level, 0)" .

bc:Ref_BoundedLanguageAgreementFailed a bc:TaxonCase ;
    bc:falsifierUnwitnessedReason """Reaching it requires Algorithm 3 to produce a structurally valid decomposition whose language differs from the net replay. Constructing one on demand means finding a bug in Algorithm 3, so the absence of a witness is the desired state, not a coverage gap.""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 2 ;
    bc:caseName "BoundedLanguageAgreementFailed" ; bc:caseShape "struct" ;
    bc:caseDoc "The two independently-computed languages disagreed at the checked bound. NOT Theorem 5.5, which quantifies over the whole language." ;
    bc:falsifier "a converted model whose denotational language differs from the token-game replay" .

bc:Ref_InternalNetConstruction a bc:TaxonCase ;
    bc:falsifierUnwitnessedReason """Algorithm-internal: a projection producing a sub-net that fails WfNet::new. Same shape as BoundedLanguageAgreementFailed -- a witness would be an internal inconsistency, not an input.""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 3 ;
    bc:caseName "InternalNetConstruction" ; bc:caseShape "tuple" ;
    bc:caseDoc "A projection produced a sub-net failing WfNet::new -- algorithm-internal, surfaced as a refusal rather than a panic." ;
    bc:falsifier "recompose output that fails WfNet::new (wf_net_bridge.rs:102)" .

bc:Casc_NumericFault a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![None, Some(0), Some(0)], vec![m(1.0), m(1000.0), m(1000.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[16]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 8 ;
    bc:caseName "NumericFault" ; bc:caseShape "struct" ;
    bc:caseDoc "A Q16.16 operation saturated or divided by zero; read off the value's error channel, with the stage named." ;
    bc:falsifier "consequence_mass(tree with mass 1000, &[16])" .

bc:Casc_EscortUnderflow a bc:TaxonCase ;
    bc:rustFalsifierSetup """let t = CascadeTree::new(vec![None, Some(0), Some(0)], vec![m(1.0), m(0.001), m(900.0)]).unwrap();""" ;
    bc:rustFalsifierExpr """consequence_mass(&t, &[16]).map(|_| ())""" ; bc:inTaxonomy bc:CascadeRefusal ; bc:caseOrder 9 ;
    bc:caseName "EscortUnderflow" ; bc:caseShape "struct" ;
    bc:caseDoc "m^q collapsed to zero from a non-zero mass: unrepresentable, not negligible. Detected structurally because saturating_mul flags overflow but not underflow." ;
    bc:falsifier "consequence_mass(tree with mass 0.01, &[16])" .

bc:Ref_VacuousLanguageBound a bc:TaxonCase ;
    bc:rustFalsifierSetup """let net = WfNet::new(["i","m","o"].map(s), [("t1",Some(s("A"))),("t2",Some(s("B")))].map(|(t,l)|(s(t),l)), [("i","t1"),("m","t2")].map(|(p,t)|(s(p),s(t))), [("t1","m"),("t2","o")].map(|(t,p)|(s(t),s(p))), "i", "o").unwrap();""" ;
    bc:rustFalsifierExpr """convert_and_verify(&net, 64, 0).map(|_| ())""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 4 ;
    bc:caseName "VacuousLanguageBound" ; bc:caseShape "unit" ;
    bc:caseDoc "A bound of 0 compares two empty sets. Both enumerators return the empty language there, so they agree vacuously -- independence of implementation does not imply independence of failure mode." ;
    bc:falsifier "convert_and_verify(net, 64, 0)" .

bc:Ref_NotSafe a bc:TaxonCase ;
    bc:rustFalsifierSetup """let net = WfNet::new(["i","a","b","c","o"].map(s), [("t1",None),("t2",None),("t3",None),("t4",None)].map(|(t,l)|(s(t),l)), [("i","t1"),("a","t2"),("b","t3"),("c","t4")].map(|(p,t)|(s(p),s(t))), [("t1","a"),("t1","b"),("t2","c"),("t3","c"),("t4","o")].map(|(t,p)|(s(t),s(p))), "i", "o").unwrap();""" ;
    bc:rustFalsifierExpr """convert(&net).map(|_| ())""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 6 ;
    bc:caseName "NotSafe" ; bc:caseShape "struct" ;
    bc:caseDoc "Some reachable marking carries more than one token in a place. Lemmas 5.1-5.4 assume a safe net, so Algorithm 3 would return a model with no proof attached." ;
    bc:falsifier "two transitions depositing into one place: check_soundness reports unsafe_witness [0,0,2,0,0]" .

bc:Ref_NotSound a bc:TaxonCase ;
    bc:rustFalsifierSetup """let net = WfNet::new(["i","a","b","o"].map(s), [("t1",None),("t2",None),("t3",None)].map(|(t,l)|(s(t),l)), [("i","t1"),("a","t2"),("a","t3"),("b","t3")].map(|(p,t)|(s(p),s(t))), [("t1","a"),("t1","b"),("t2","o"),("t3","o")].map(|(t,p)|(s(t),s(p))), "i", "o").unwrap();""" ;
    bc:rustFalsifierExpr """convert(&net).map(|_| ())""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 7 ;
    bc:caseName "NotSound" ; bc:caseShape "struct" ;
    bc:caseDoc "At least one of van der Aalst's three clauses fails: option-to-complete, proper completion, no dead transitions." ;
    bc:falsifier "a net with a transition enabled in no reachable marking" .

bc:Ref_SoundnessUndecided a bc:TaxonCase ;
    bc:falsifierUnwitnessedReason """Requires a net whose reachable marking count exceeds MAX_REACHABLE_MARKINGS (200000). Such a net exists and is easy to describe, but replaying it costs seconds and the assertion adds nothing the bound itself does not already state.""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 8 ;
    bc:caseName "SoundnessUndecided" ; bc:caseShape "struct" ;
    bc:caseDoc "The reachability graph exceeded MAX_REACHABLE_MARKINGS before the token game terminated. Undecided, not decided favourably." ;
    bc:falsifier "a net whose reachable marking count exceeds MAX_REACHABLE_MARKINGS" .

bc:Ref_NotRecomposable a bc:TaxonCase ;
    bc:falsifierUnwitnessedReason """Raised by recompose, not by convert: no WfNet input reaches it, because convert never emits a bounded DoRedo. Witnessing it means starting from a Powl2Model, which is a different entry point than the one this projection covers.""" ; bc:inTaxonomy bc:RefusalReason ; bc:caseOrder 5 ;
    bc:caseName "NotRecomposable" ; bc:caseShape "tuple" ;
    bc:caseDoc "The model has no language-preserving WF-net image -- e.g. a bounded DoRedo, which an unbounded net cycle would widen." ;
    bc:falsifier "recompose(DoRedo { max_redos: 2, .. })" .

################################################################################
# Reference implementations used as differential oracles.
#
# An oracle is not a dependency. It is a second implementation of the same
# specification, written by someone else, whose agreement is evidence and whose
# disagreement is a finding. The value is entirely in the independence -- which
# is why none of these may be vendored into the tree even when the licence would
# allow it: an oracle maintained here stops being independent.
#
# Admitted here so the pinned commit is ONE fact. It was briefly duplicated
# between oracles/fetch.sh and oracles/README.md, which is the same drift this
# graph exists to prevent, reintroduced by the harness built to detect it.
################################################################################

bc:ReferenceImplementation a rdfs:Class .

# How a claim in this graph was established. Every layer of checking has a
# blind spot that another layer targets, so a claim's provenance decides which
# blind spot it might still be sitting in -- and a claim established by READING
# is exactly the residual class the stack does not close: it passes the type
# system, ggen, the oracle differential and the test suite alike, because none
# of them ever looks at it.
bc:EvidenceKind a rdfs:Class .

bc:EvidenceRead a bc:EvidenceKind ;
    rdfs:label "read" ;
    bc:evidenceDoc "Established by reading a specification or a reference implementation's source. Nothing executes it. A misreading survives every automated layer here." .

bc:EvidenceRun a bc:EvidenceKind ;
    rdfs:label "run" ;
    bc:evidenceDoc "Established by executing an input and recording what actually happened. Decides the case that was run and no other." .

bc:EvidenceDifferential a bc:EvidenceKind ;
    rdfs:label "differential" ;
    bc:evidenceDoc "Established by two independent implementations disagreeing on the same input. Stronger than a run: it shows one of the two misunderstands the specification, which internal consistency cannot reveal." .

bc:Ref_POWL a bc:ReferenceImplementation ;
    rdfs:label "powl" ;
    bc:referenceTitle    "POWL 2.0 reference implementation" ;
    bc:referenceUrl      "https://github.com/seanchatmangpt/POWL.git" ;
    bc:referenceCommit   "d2bae89b4f3a6375b56225ecfaf5eac3797900dc" ;
    bc:referenceLanguage "Python" ;
    bc:referenceLicence  "AGPL-3.0" ;
    bc:referenceVendorable false ;
    bc:referenceCovers   "Algorithm 3: WF-net to POWL 2.0. Runnable today; oracles/differential.py compares conversion verdicts over the shared corpus." .

bc:Ref_VAL a bc:ReferenceImplementation ;
    rdfs:label "val" ;
    bc:referenceTitle    "VAL, the PDDL plan validator" ;
    bc:referenceUrl      "https://github.com/KCL-Planning/VAL.git" ;
    bc:referenceCommit   "3c7a1f330bdab0ba28a4762bb45c3f06c27fb6d4" ;
    bc:referenceLanguage "C++" ;
    bc:referenceLicence  "BSD-3-Clause" ;
    bc:referenceVendorable false ;
    bc:referenceCovers   "PDDL plan validity: durative-action semantics, at-end condition timing, and all eleven trajectory-constraint sorts. Source fetched and read; no harness wired yet, so every Found this repository produces is still checked only by the code that produced it." .
