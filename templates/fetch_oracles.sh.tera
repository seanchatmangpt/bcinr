#!/usr/bin/env bash
# GENERATED by `ggen sync` from ontology/bcinr.ttl + imports -- DO NOT EDIT.
#
# Fetch pinned oracle sources into oracles/vendor/, which is gitignored. Running
# a program and comparing its output is ordinary use; copying its source into a
# permissively licensed tree is not, and an oracle that lives here stops being
# the independent implementation that made it worth having.
set -euo pipefail
cd "$(dirname "$0")"
mkdir -p vendor

fetch() { # name url commit
    local name=$1 url=$2 commit=$3
    [ -d "vendor/$name/.git" ] || git clone -q "$url" "vendor/$name"
    git -C "vendor/$name" fetch -q --depth 1 origin "$commit" 2>/dev/null \
        || git -C "vendor/$name" fetch -q origin
    git -C "vendor/$name" checkout -q "$commit"
    echo "$name: pinned at $commit"
}
{% for r in results %}
# {{ r.title }} ({{ r.language }}, {{ r.licence }})
#   Covers: {{ r.covers }}
#   Licence: {{ r.vendor_note }}
fetch {{ r.name }} {{ r.url }} {{ r.commit }}
{% endfor %}
