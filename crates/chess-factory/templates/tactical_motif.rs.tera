{#- tactical_motif.rs.tera — renders ONE branchless tactical-motif file per row.

    FANOUT: paired with tactical_motifs.rq under a rule whose
    output_file = "src/motifs/{{name}}.rs". The "{{" in the path makes ggen
    render this template ONCE PER ROW with that row's scalars bound directly
    ({{ id }}, {{ name }}, ...). Do NOT iterate `sparql_results`.

    PROVISION LAW (GGEN-TPL-001): every variable below is projected by
    tactical_motifs.rq: id, name, lowering, primitive, inputMask, eventCode,
    eventName, authority, doc, kernelHelpers, detectBody, firedBody, oracleBody.

    BRANCHLESS CONTRACT: the public `detect`/`fired` kernels are cyclomatic
    complexity 1 (no if/match/for/while/loop). All looping detection (attack
    sweeps, ray walks, square-by-square folds) lives in PRIVATE `pub(super)`
    helpers rendered from `kernelHelpers` — exempt from the CC=1 gate by the
    looping-projection rule. The branchful `_reference` oracle (test-only,
    `oracleBody`) is a STRUCTURALLY INDEPENDENT implementation of the same law,
    and a proptest asserts kernel == oracle over generated legal positions.
-#}
#![forbid(unsafe_code)]

//! Tactical motif: {{ eventName }} (id {{ id }}).
//!
//! # Branchless Contract
//! **Ensures:** `detect` matches the independent branchful `_reference` oracle.
//! **Invariant:** the public execution path is data-independent (CC=1); all
//! looping detection is delegated to private `pub(super)` helpers.
//!
//! Lowering: {{ lowering }}. Primitive: `{{ primitive }}`.
//! Input mask: `{{ inputMask }}`. Authority: {{ authority }}
//!
//! {{ doc }}

#[allow(unused_imports)]
use crate::position::{PositionView, BISHOP, KING, KNIGHT, PAWN, QUEEN, ROOK};

/// Stable ordinal identifier of this motif (ORDER BY anchor in the ontology).
pub const MOTIF_ID: u16 = {{ id }};
/// OCEL event code emitted when the motif fires.
pub const EVENT_CODE: u16 = {{ eventCode }};

{{ kernelHelpers }}

/// Branchless tactical detector for **{{ name }}**.
///
/// Returns the bitmask of board squares that participate in the motif for the
/// side to move (`v.stm`). Pure delegation to private looping helpers; the
/// public body is a single expression (CC = 1).
#[must_use]
#[inline(always)]
pub fn detect(v: &PositionView) -> u64 {
    {{ detectBody }}
}

/// Whether the motif fired at all (all-ones if any square set, else zero).
/// Branchless: CC = 1.
#[must_use]
#[inline(always)]
pub fn fired(v: &PositionView) -> u64 {
    {{ firedBody }}
}

#[cfg(test)]
mod tests {
    #![allow(clippy::needless_range_loop)]
    extern crate std;
    use super::*;
    use proptest::prelude::*;

    /// Structurally INDEPENDENT branchful reference oracle for the **{{ name }}**
    /// law. Test-only, MAY branch; `detect` MUST match it on every position.
    /// Authority: {{ authority }}
    fn reference_detect(v: &PositionView) -> u64 {
        {{ oracleBody }}
    }

    /// Build a [`PositionView`] from a chess board reached by a short random
    /// legal game, so every test position is legal (no impossible bitboards).
    #[cfg(feature = "std")]
    fn legal_position(seed: u64) -> PositionView {
        use chess::{Board, MoveGen};
        let mut board = Board::default();
        let mut state = seed.wrapping_mul(0x9E37_79B9_7F4A_7C15).wrapping_add(1);
        let mut ply = 0;
        while ply < (seed % 40) as usize + 4 {
            let gen = MoveGen::new_legal(&board);
            let n = gen.len();
            if n == 0 {
                break;
            }
            state ^= state << 13;
            state ^= state >> 7;
            state ^= state << 17;
            let pick = (state as usize) % n;
            let mv = MoveGen::new_legal(&board).nth(pick).unwrap();
            board = board.make_move_new(mv);
            ply += 1;
        }
        PositionView::from_board(&board)
    }

    #[cfg(feature = "std")]
    proptest! {
        /// Kernel == independent oracle over legal positions reached by random play.
        #[test]
        fn prop_kernel_matches_oracle(seed in any::<u64>()) {
            let v = legal_position(seed);
            prop_assert_eq!(detect(&v), reference_detect(&v), "fen-seed {}", seed);
        }
    }

    #[test]
    fn empty_position_never_fires() {
        let v = PositionView::default();
        assert_eq!(detect(&v), 0);
        assert_eq!(reference_detect(&v), 0);
        assert_eq!(fired(&v), 0);
    }
}
