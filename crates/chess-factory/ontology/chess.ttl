@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cf:   <https://bcinr.dev/chess-factory/ontology#> .

#################################################################
# bcinr Chess Factory — PROGRAM LAW
#
# The semantic source of truth for the chess decision-system manufacturing
# cell. `ggen sync` lowers this graph through SPARQL (queries/*.rq) and Tera
# (templates/*.tera) into first-class Rust source under src/. Swap this file
# for market.ttl to retarget the same machinery to UHFT.
#
# Material values updated to PeSTO midgame values (stronger conversion):
#   piece_values = [Pawn 82, Knight 337, Bishop 365, Rook 477, Queen 1025,
#                   King 20000]  (centipawns; PeSTO midgame; PST added).
# material weight_q8 raised from 128 to 256 (was 0.5x, now full weight).
# mobility scoreScale raised from 4 to 6 cp/square.
# king_safety scoreScale raised from 12 to 20 cp/ring-square.
#
# Generated source is FIRST-CLASS (GGEN-SRC law): no generated/ paths, no
# DO-NOT-EDIT caste. Edit this TTL and regenerate; never hand-edit output.
#
# PARITY: 10 cf:FeatureStation + 4 cf:TacticalMotif + 6 cf:Defect individuals.
# Every cf:id is a unique integer ORDER-BY anchor (determinism).
#################################################################

#################################################################
# Classes
#################################################################

cf:Piece a rdfs:Class ;
    rdfs:comment "A chess piece type carrying a centipawn base material value." .

cf:Square a rdfs:Class ;
    rdfs:comment "A board square (0..63, a1=0, sq = rank*8 + file)." .

cf:FeatureStation a rdfs:Class ;
    rdfs:comment "A branchless evaluation station: PositionView -> Score(cp) -> Evidence. CC=1 kernel." .

cf:StrategyStation a rdfs:Class ;
    rdfs:comment "A composed station aggregating feature stations into a strategic verdict." .

cf:TacticalMotif a rdfs:Class ;
    rdfs:comment "A bitwise tactical detector producing a fired mask (hanging, fork, pin, skewer)." .

cf:Defect a rdfs:Class ;
    rdfs:comment "A named-law defect class mapped to a Refusal + DiagnosticPayload." .

cf:Lowering a rdfs:Class ;
    rdfs:comment "A branchless lowering strategy a station compiles into (Mask/Bitset/Network/Lut/Saturating)." .

#################################################################
# Lowering individuals (the branchless calculus primitives)
#################################################################

cf:Mask        a cf:Lowering ; rdfs:label "Mask" .
cf:Bitset      a cf:Lowering ; rdfs:label "Bitset" .
cf:Network     a cf:Lowering ; rdfs:label "Network" .
cf:Lut         a cf:Lowering ; rdfs:label "Lut" .
cf:Saturating  a cf:Lowering ; rdfs:label "Saturating" .

#################################################################
# Properties — Piece
#################################################################

cf:baseValue a rdf:Property ; rdfs:domain cf:Piece ; rdfs:range xsd:integer ;
    rdfs:comment "Base material value in centipawns (from nnue.rs piece_values)." .

#################################################################
# Properties — FeatureStation
#################################################################

cf:id a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:comment "Unique integer identity and stable ORDER BY anchor (determinism)." .

cf:name a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "snake_case station name; becomes the generated module/file name." .

cf:lowering a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range cf:Lowering ;
    rdfs:comment "Branchless lowering strategy the station kernel compiles into." .

cf:primitive a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "use-path into the branchless primitive (rays / bcinr-logic) the kernel calls." .

cf:inputMask a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range xsd:string ;
    rdfs:comment "PositionView bitboard accessor the kernel consumes as its packed input." .

cf:scoreScale a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range xsd:integer ;
    rdfs:comment "Centipawn multiplier applied to the station's raw count to produce raw_cp." .

cf:weight_q8 a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:comment "Q8.8 fixed-point aggregation weight (256 == 1.0). Default 256." .

cf:eventCode a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:comment "OCEL event code emitted when the station fires (evidence stream)." .

cf:eventName a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "OCEL event name for the station's evidence edge." .

cf:authority a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "One-line oracle predicate: the branchful reference equality a proptest must hold." .

cf:doc a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "Human-readable doc comment for the generated station." .

cf:kernelHelpers a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range xsd:string ;
    rdfs:comment "Private (non-public) Rust helpers — uses/consts/looping folds — rendered above the CC=1 kernel. Outside the station boundary (looping-projection rule)." .

cf:kernelBody a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range xsd:string ;
    rdfs:comment "Body of the public branchless `raw_cp` kernel: a single CC=1 reduction (no if/match/for/while/loop) calling the private helpers." .

cf:oracleBody a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range xsd:string ;
    rdfs:comment "Body of the branchful test-only `_reference` oracle that the kernel must equal for every input." .

cf:firedExpr a rdf:Property ; rdfs:domain cf:FeatureStation ; rdfs:range xsd:string ;
    rdfs:comment "Branchless expression producing the evidence fired_mask (squares/features that contributed)." .

#################################################################
# Properties — StrategyStation
#################################################################

cf:composedOf a rdf:Property ; rdfs:domain cf:StrategyStation ; rdfs:range cf:FeatureStation ;
    rdfs:comment "Feature stations a strategy station aggregates." .

#################################################################
# Properties — Defect
#################################################################

cf:code a rdf:Property ; rdfs:domain cf:Defect ; rdfs:range xsd:integer ;
    rdfs:comment "Stable integer defect code (ORDER BY anchor for the taxonomy table)." .

#################################################################
# Pieces — material law (centipawns, from nnue.rs piece_values)
#################################################################

cf:Pawn   a cf:Piece ; cf:name "pawn"   ; cf:id 0 ; cf:baseValue 82    .
cf:Knight a cf:Piece ; cf:name "knight" ; cf:id 1 ; cf:baseValue 337   .
cf:Bishop a cf:Piece ; cf:name "bishop" ; cf:id 2 ; cf:baseValue 365   .
cf:Rook   a cf:Piece ; cf:name "rook"   ; cf:id 3 ; cf:baseValue 477   .
cf:Queen  a cf:Piece ; cf:name "queen"  ; cf:id 4 ; cf:baseValue 1025  .
cf:King   a cf:Piece ; cf:name "king"   ; cf:id 5 ; cf:baseValue 20000 .

#################################################################
# Feature stations — 6 (decompose nnue.rs neuron 0)
#################################################################

cf:material a cf:FeatureStation ;
    cf:id 0 ;
    cf:name "material" ;
    cf:lowering cf:Saturating ;
    cf:primitive "bcinr_logic::bitset::popcount_u64" ;
    cf:inputMask "occupancy_by_piece" ;
    cf:scoreScale 1 ;
    cf:weight_q8 256 ;
    cf:eventCode 1000 ;
    cf:eventName "material_evaluated" ;
    cf:authority "raw_cp == sum_over_pieces(popcount(my[p]) - popcount(opp[p])) * baseValue[p]" ;
    cf:doc "White-relative material balance: signed Q0 popcount of each piece type scaled by its centipawn base value (Pawn 100 .. King 20000)." ;
    cf:kernelHelpers """/// Per-piece centipawn base values (PeSTO midgame), indexed
/// pawn..king. King is valued at 20000 so material dominates.
const BASE_VALUE: [i32; 6] = [82, 337, 365, 477, 1025, 20000];

/// Weighted popcount fold for one color (private; loops, so outside CC=1).
#[inline]
fn weighted_material(v: &PositionView, color: usize) -> i32 {
    let mut acc = 0i32;
    let mut p = 0usize;
    while p < 6 {
        acc += (v.by_piece[color][p].count_ones() as i32) * BASE_VALUE[p];
        p += 1;
    }
    acc
}""" ;
    cf:kernelBody """(weighted_material(v, WHITE) - weighted_material(v, BLACK)).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """const BASE: [i32; 6] = [82, 337, 365, 477, 1025, 20000];
        let mut white = 0i32;
        let mut black = 0i32;
        let mut p = 0usize;
        while p < 6 {
            white += v.by_piece[WHITE][p].count_ones() as i32 * BASE[p];
            black += v.by_piece[BLACK][p].count_ones() as i32 * BASE[p];
            p += 1;
        }
        (white - black) * SCORE_SCALE""" ;
    cf:firedExpr """v.by_color[WHITE] | v.by_color[BLACK]""" .

cf:pst a cf:FeatureStation ;
    cf:id 1 ;
    cf:name "pst" ;
    cf:lowering cf:Lut ;
    cf:primitive "crate::tables::PST_Q0" ;
    cf:inputMask "occupancy_by_piece_square" ;
    cf:scoreScale 1 ;
    cf:weight_q8 256 ;
    cf:eventCode 1001 ;
    cf:eventName "pst_evaluated" ;
    cf:authority "raw_cp == sum_over_pieces_squares(white_bit ? +pst[p][sq^56] : 0) - (black_bit ? +pst[p][sq] : 0)" ;
    cf:doc "Piece-square-table positional bonus (PeSTO-style middlegame): central advancement rewarded, rim/edge penalised; black mirrors rank (sq^56) for white-relative score." ;
    cf:kernelHelpers """/// PeSTO-style middlegame piece-square tables, listed a8..h1 (table row 0
/// = rank 8). White reads `PST[p][sq ^ 56]` (rank-flip), black reads
/// `PST[p][sq]`, giving a white-relative positional score.
const PST: [[i32; 64]; 6] = [
    // Pawn
    [  0,  0,  0,  0,  0,  0,  0,  0,
      98,134, 61, 95, 68,126, 34,-11,
      -6,  7, 26, 31, 65, 56, 25,-20,
     -14, 13,  6, 21, 23, 12, 17,-23,
     -27, -2, -5, 12, 17,  6, 10,-25,
     -26, -4, -4,-10,  3,  3, 33,-12,
     -35, -1,-20,-23,-15, 24, 38,-22,
       0,  0,  0,  0,  0,  0,  0,  0],
    // Knight
    [-167,-89,-34,-49, 61,-97,-15,-107,
      -73,-41, 72, 36, 23, 62,  7, -17,
      -47, 60, 37, 65, 84,129, 73,  44,
       -9, 17, 19, 53, 37, 69, 18,  22,
      -13,  4, 16, 13, 28, 19, 21,  -8,
      -23, -9, 12, 10, 19, 17, 25, -16,
      -29,-53,-12, -3, -1, 18,-14, -19,
     -105,-21,-58,-33,-17,-28,-19, -23],
    // Bishop
    [-29,  4,-82,-37,-25,-42,  7, -8,
     -26, 16,-18,-13, 30, 59, 18,-47,
     -16, 37, 43, 40, 35, 50, 37, -2,
      -4,  5, 19, 50, 37, 37,  7, -2,
      -6, 13, 13, 26, 34, 12, 10,  4,
       0, 15, 15, 15, 14, 27, 18, 10,
       4, 15, 16,  0,  7, 21, 33,  1,
     -33, -3,-14,-21,-13,-12,-39,-21],
    // Rook
    [ 32, 42, 32, 51, 63,  9, 31, 43,
      27, 32, 58, 62, 80, 67, 26, 44,
      -5, 19, 26, 36, 17, 45, 61, 16,
     -24,-11,  7, 26, 24, 35, -8,-20,
     -36,-26,-12, -1,  9, -7,  6,-23,
     -45,-25,-16,-17,  3,  0, -5,-33,
     -44,-16,-20, -9, -1, 11, -6,-71,
     -19,-13,  1, 17, 16,  7,-37,-26],
    // Queen
    [-28,  0, 29, 12, 59, 44, 43, 45,
     -24,-39, -5,  1,-16, 57, 28, 54,
     -13,-17,  7,  8, 29, 56, 47, 57,
     -27,-27,-16,-16, -1, 17, -2,  1,
      -9,-26, -9,-10, -2, -4,  3, -3,
     -14,  2,-11, -2, -5,  2, 14,  5,
     -35, -8, 11,  2,  8, 15, -3,  1,
      -1,-18, -9, 10,-15,-25,-31,-50],
    // King
    [-65, 23, 16,-15,-56,-34,  2, 13,
      29, -1,-20, -7, -8, -4,-38,-29,
      -9, 24,  2,-16,-20,  6, 22,-22,
     -17,-20,-12,-27,-30,-25,-14,-36,
     -49, -1,-27,-39,-46,-44,-33,-51,
     -14,-14,-22,-46,-44,-30,-15,-27,
       1,  7, -8,-64,-43,-16,  9,  8,
     -15, 36, 12,-54,  8,-28, 24, 14],
];

/// Folded white-relative PST score over all pieces/squares (private; loops).
#[inline]
fn pst_score(v: &PositionView) -> i32 {
    let mut acc = 0i32;
    let mut p = 0usize;
    while p < 6 {
        let mut w = v.by_piece[WHITE][p];
        while w != 0 {
            let sq = w.trailing_zeros() as usize;
            acc += PST[p][sq ^ 56];
            w &= w - 1;
        }
        let mut b = v.by_piece[BLACK][p];
        while b != 0 {
            let sq = b.trailing_zeros() as usize;
            acc -= PST[p][sq];
            b &= b - 1;
        }
        p += 1;
    }
    acc
}""" ;
    cf:kernelBody """pst_score(v).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """const T: [[i32; 64]; 6] = [
            [  0,  0,  0,  0,  0,  0,  0,  0, 98,134, 61, 95, 68,126, 34,-11, -6,  7, 26, 31, 65, 56, 25,-20,-14, 13,  6, 21, 23, 12, 17,-23,-27, -2, -5, 12, 17,  6, 10,-25,-26, -4, -4,-10,  3,  3, 33,-12,-35, -1,-20,-23,-15, 24, 38,-22,  0,  0,  0,  0,  0,  0,  0,  0],
            [-167,-89,-34,-49, 61,-97,-15,-107,-73,-41, 72, 36, 23, 62,  7, -17,-47, 60, 37, 65, 84,129, 73,  44, -9, 17, 19, 53, 37, 69, 18,  22,-13,  4, 16, 13, 28, 19, 21,  -8,-23, -9, 12, 10, 19, 17, 25, -16,-29,-53,-12, -3, -1, 18,-14, -19,-105,-21,-58,-33,-17,-28,-19, -23],
            [-29,  4,-82,-37,-25,-42,  7, -8,-26, 16,-18,-13, 30, 59, 18,-47,-16, 37, 43, 40, 35, 50, 37, -2, -4,  5, 19, 50, 37, 37,  7, -2, -6, 13, 13, 26, 34, 12, 10,  4,  0, 15, 15, 15, 14, 27, 18, 10,  4, 15, 16,  0,  7, 21, 33,  1,-33, -3,-14,-21,-13,-12,-39,-21],
            [ 32, 42, 32, 51, 63,  9, 31, 43, 27, 32, 58, 62, 80, 67, 26, 44, -5, 19, 26, 36, 17, 45, 61, 16,-24,-11,  7, 26, 24, 35, -8,-20,-36,-26,-12, -1,  9, -7,  6,-23,-45,-25,-16,-17,  3,  0, -5,-33,-44,-16,-20, -9, -1, 11, -6,-71,-19,-13,  1, 17, 16,  7,-37,-26],
            [-28,  0, 29, 12, 59, 44, 43, 45,-24,-39, -5,  1,-16, 57, 28, 54,-13,-17,  7,  8, 29, 56, 47, 57,-27,-27,-16,-16, -1, 17, -2,  1, -9,-26, -9,-10, -2, -4,  3, -3,-14,  2,-11, -2, -5,  2, 14,  5,-35, -8, 11,  2,  8, 15, -3,  1, -1,-18, -9, 10,-15,-25,-31,-50],
            [-65, 23, 16,-15,-56,-34,  2, 13, 29, -1,-20, -7, -8, -4,-38,-29, -9, 24,  2,-16,-20,  6, 22,-22,-17,-20,-12,-27,-30,-25,-14,-36,-49, -1,-27,-39,-46,-44,-33,-51,-14,-14,-22,-46,-44,-30,-15,-27,  1,  7, -8,-64,-43,-16,  9,  8,-15, 36, 12,-54,  8,-28, 24, 14],
        ];
        let mut acc = 0i32;
        let mut p = 0usize;
        while p < 6 {
            let mut sq = 0usize;
            while sq < 64 {
                let m = 1u64 << sq;
                if v.by_piece[WHITE][p] & m != 0 {
                    acc += T[p][sq ^ 56];
                }
                if v.by_piece[BLACK][p] & m != 0 {
                    acc -= T[p][sq];
                }
                sq += 1;
            }
            p += 1;
        }
        acc * SCORE_SCALE""" ;
    cf:firedExpr """v.by_color[WHITE] | v.by_color[BLACK]""" .

cf:mobility a cf:FeatureStation ;
    cf:id 2 ;
    cf:name "mobility" ;
    cf:lowering cf:Bitset ;
    cf:primitive "crate::rays::kogge_stone_attacks" ;
    cf:inputMask "sliders_and_leapers" ;
    cf:scoreScale 6 ;
    cf:weight_q8 256 ;
    cf:eventCode 1002 ;
    cf:eventName "mobility_evaluated" ;
    cf:authority "raw_cp == (popcount(my_attacks & empty) - popcount(opp_attacks & empty)) * 6" ;
    cf:doc "Mobility differential: Kogge-Stone rook/bishop/queen attack spans plus knight/king masks, counting reachable empty squares; 4 cp per square (reuses legal_moves)." ;
    cf:kernelHelpers """use crate::rays::{bishop_attacks, queen_attacks, rook_attacks, KING_MASKS, KNIGHT_MASKS};
use crate::position::{BISHOP, KING, KNIGHT, QUEEN, ROOK};

/// Full attack span of one color: slider rays (Kogge-Stone, over `empty`)
/// plus knight/king leaper masks. Private (loops), outside CC=1.
#[inline]
pub(super) fn attack_span(v: &PositionView, color: usize) -> u64 {
    let empty = v.empty;
    let mut span = 0u64;
    let mut bb = v.by_piece[color][ROOK];
    while bb != 0 {
        span |= rook_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][BISHOP];
    while bb != 0 {
        span |= bishop_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][QUEEN];
    while bb != 0 {
        span |= queen_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][KNIGHT];
    while bb != 0 {
        span |= KNIGHT_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][KING];
    while bb != 0 {
        span |= KING_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    span
}""" ;
    cf:kernelBody """let my = (attack_span(v, WHITE) & v.empty).count_ones() as i32;
    let opp = (attack_span(v, BLACK) & v.empty).count_ones() as i32;
    (my - opp).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """let white_span = super::attack_span(v, WHITE);
        let black_span = super::attack_span(v, BLACK);
        let mut white = 0i32;
        let mut black = 0i32;
        let mut sq = 0usize;
        while sq < 64 {
            let m = 1u64 << sq;
            if (white_span & v.empty & m) != 0 {
                white += 1;
            }
            if (black_span & v.empty & m) != 0 {
                black += 1;
            }
            sq += 1;
        }
        (white - black) * SCORE_SCALE""" ;
    cf:firedExpr """attack_span(v, WHITE) | attack_span(v, BLACK)""" .

cf:king_safety a cf:FeatureStation ;
    cf:id 3 ;
    cf:name "king_safety" ;
    cf:lowering cf:Mask ;
    cf:primitive "crate::rays::king_ring" ;
    cf:inputMask "king_ring_and_attacks" ;
    cf:scoreScale 20 ;
    cf:weight_q8 256 ;
    cf:eventCode 1003 ;
    cf:eventName "king_safety_evaluated" ;
    cf:authority "raw_cp == (popcount(my_attacks & opp_king_ring) - popcount(opp_attacks & my_king_ring)) * 20" ;
    cf:doc "King safety: net attackers on the enemy king ring (8-neighbourhood) minus attackers on our own king ring, 12 cp per attacked ring square; white-relative and signed." ;
    cf:kernelHelpers """use crate::rays::{bishop_attacks, queen_attacks, rook_attacks, KING_MASKS, KNIGHT_MASKS};
use crate::position::{BISHOP, KING, KNIGHT, QUEEN, ROOK};

/// Full attack span of one color (see mobility). Private, loops.
#[inline]
pub(super) fn attack_span(v: &PositionView, color: usize) -> u64 {
    let empty = v.empty;
    let mut span = 0u64;
    let mut bb = v.by_piece[color][ROOK];
    while bb != 0 {
        span |= rook_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][BISHOP];
    while bb != 0 {
        span |= bishop_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][QUEEN];
    while bb != 0 {
        span |= queen_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][KNIGHT];
    while bb != 0 {
        span |= KNIGHT_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][KING];
    while bb != 0 {
        span |= KING_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    span
}

/// 8-neighbourhood ring around every king of `color`. Private, loops.
#[inline]
pub(super) fn king_ring(v: &PositionView, color: usize) -> u64 {
    let mut ring = 0u64;
    let mut bb = v.by_piece[color][KING];
    while bb != 0 {
        ring |= KING_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    ring
}""" ;
    cf:kernelBody """let on_opp = (attack_span(v, WHITE) & king_ring(v, BLACK)).count_ones() as i32;
    let on_my = (attack_span(v, BLACK) & king_ring(v, WHITE)).count_ones() as i32;
    (on_opp - on_my).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """let white_span = super::attack_span(v, WHITE);
        let black_span = super::attack_span(v, BLACK);
        let white_ring = super::king_ring(v, WHITE);
        let black_ring = super::king_ring(v, BLACK);
        let mut on_opp = 0i32;
        let mut on_my = 0i32;
        let mut sq = 0usize;
        while sq < 64 {
            let m = 1u64 << sq;
            if (white_span & black_ring & m) != 0 {
                on_opp += 1;
            }
            if (black_span & white_ring & m) != 0 {
                on_my += 1;
            }
            sq += 1;
        }
        (on_opp - on_my) * SCORE_SCALE""" ;
    cf:firedExpr """king_ring(v, WHITE) | king_ring(v, BLACK)""" .

cf:pawn_structure a cf:FeatureStation ;
    cf:id 4 ;
    cf:name "pawn_structure" ;
    cf:lowering cf:Bitset ;
    cf:primitive "crate::rays::file_fill" ;
    cf:inputMask "pawns_by_color" ;
    cf:scoreScale 15 ;
    cf:weight_q8 256 ;
    cf:eventCode 1004 ;
    cf:eventName "pawn_structure_evaluated" ;
    cf:authority "raw_cp == (opp_doubled + opp_isolated - my_doubled - my_isolated) * 15" ;
    cf:doc "Pawn structure: doubled (extra pawns beyond one per file) and isolated (no friendly pawn on either adjacent file) pawns penalised 15 cp each; white-relative." ;
    cf:kernelHelpers """use crate::position::PAWN;

/// File masks (A..H); FILES[f] selects every square on file f.
const FILES: [u64; 8] = [
    0x0101_0101_0101_0101,
    0x0202_0202_0202_0202,
    0x0404_0404_0404_0404,
    0x0808_0808_0808_0808,
    0x1010_1010_1010_1010,
    0x2020_2020_2020_2020,
    0x4040_4040_4040_4040,
    0x8080_8080_8080_8080,
];

/// doubled+isolated penalty count for one color's pawns. Private, loops.
#[inline]
pub(super) fn pawn_penalty(v: &PositionView, color: usize) -> i32 {
    let pawns = v.by_piece[color][PAWN];
    let mut penalty = 0i32;
    let mut f = 0usize;
    while f < 8 {
        let on_file = (pawns & FILES[f]).count_ones() as i32;
        if on_file > 0 {
            // doubled: every pawn beyond the first on this file.
            penalty += on_file - 1;
            // isolated: no friendly pawn on either adjacent file.
            let mut neighbour = false;
            if f > 0 && (pawns & FILES[f - 1]) != 0 {
                neighbour = true;
            }
            if f < 7 && (pawns & FILES[f + 1]) != 0 {
                neighbour = true;
            }
            if !neighbour {
                penalty += on_file;
            }
        }
        f += 1;
    }
    penalty
}""" ;
    cf:kernelBody """(pawn_penalty(v, BLACK) - pawn_penalty(v, WHITE)).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """fn pen(pawns: u64) -> i32 {
            const FILE_A: u64 = 0x0101_0101_0101_0101;
            let mut p = 0i32;
            let mut f = 0usize;
            while f < 8 {
                let file = FILE_A << f;
                let n = (pawns & file).count_ones() as i32;
                if n > 0 {
                    p += n - 1;
                    let mut has_neighbour = false;
                    if f > 0 && (pawns & (FILE_A << (f - 1))) != 0 {
                        has_neighbour = true;
                    }
                    if f < 7 && (pawns & (FILE_A << (f + 1))) != 0 {
                        has_neighbour = true;
                    }
                    if !has_neighbour {
                        p += n;
                    }
                }
                f += 1;
            }
            p
        }
        (pen(v.by_piece[BLACK][PAWN]) - pen(v.by_piece[WHITE][PAWN])) * SCORE_SCALE""" ;
    cf:firedExpr """v.by_piece[WHITE][PAWN] | v.by_piece[BLACK][PAWN]""" .

cf:center_control a cf:FeatureStation ;
    cf:id 5 ;
    cf:name "center_control" ;
    cf:lowering cf:Mask ;
    cf:primitive "crate::rays::CENTER_MASK" ;
    cf:inputMask "attacks_by_color" ;
    cf:scoreScale 10 ;
    cf:weight_q8 256 ;
    cf:eventCode 1005 ;
    cf:eventName "center_control_evaluated" ;
    cf:authority "raw_cp == (popcount(my_attacks & CENTER) - popcount(opp_attacks & CENTER)) * 10" ;
    cf:doc "Center control: net attacks on the d4/e4/d5/e5 center mask, 10 cp per controlled central square; white-relative bitwise AND with the fixed center LUT." ;
    cf:kernelHelpers """use crate::rays::{bishop_attacks, queen_attacks, rook_attacks, KING_MASKS, KNIGHT_MASKS};
use crate::position::{BISHOP, KING, KNIGHT, QUEEN, ROOK};

/// d4 | e4 | d5 | e5 center squares (sq = rank*8 + file).
const CENTER: u64 = (1u64 << 27) | (1u64 << 28) | (1u64 << 35) | (1u64 << 36);

/// Full attack span of one color (see mobility). Private, loops.
#[inline]
pub(super) fn attack_span(v: &PositionView, color: usize) -> u64 {
    let empty = v.empty;
    let mut span = 0u64;
    let mut bb = v.by_piece[color][ROOK];
    while bb != 0 {
        span |= rook_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][BISHOP];
    while bb != 0 {
        span |= bishop_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][QUEEN];
    while bb != 0 {
        span |= queen_attacks(bb & bb.wrapping_neg(), empty);
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][KNIGHT];
    while bb != 0 {
        span |= KNIGHT_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    let mut bb = v.by_piece[color][KING];
    while bb != 0 {
        span |= KING_MASKS[bb.trailing_zeros() as usize];
        bb &= bb - 1;
    }
    span
}""" ;
    cf:kernelBody """let my = (attack_span(v, WHITE) & CENTER).count_ones() as i32;
    let opp = (attack_span(v, BLACK) & CENTER).count_ones() as i32;
    (my - opp).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """const C: u64 = (1u64 << 27) | (1u64 << 28) | (1u64 << 35) | (1u64 << 36);
        let white_span = super::attack_span(v, WHITE);
        let black_span = super::attack_span(v, BLACK);
        let mut white = 0i32;
        let mut black = 0i32;
        let mut sq = 0usize;
        while sq < 64 {
            let m = 1u64 << sq;
            if (white_span & C & m) != 0 {
                white += 1;
            }
            if (black_span & C & m) != 0 {
                black += 1;
            }
            sq += 1;
        }
        (white - black) * SCORE_SCALE""" ;
    cf:firedExpr """(attack_span(v, WHITE) | attack_span(v, BLACK)) & CENTER""" .

cf:passed_pawn a cf:FeatureStation ;
    cf:id 6 ;
    cf:name "passed_pawn" ;
    cf:lowering cf:Mask ;
    cf:primitive "crate::rays::south_fill" ;
    cf:inputMask "my_pawns & !enemy_block" ;
    cf:scoreScale 20 ;
    cf:weight_q8 256 ;
    cf:eventCode 1006 ;
    cf:eventName "passed_pawn_evaluated" ;
    cf:authority "raw_cp == sum_white_passed_pawns(RANK_BONUS[rank]) - sum_black_passed_pawns(RANK_BONUS[rank])" ;
    cf:doc "Passed pawn bonus: a pawn with no enemy pawn on the same or adjacent files ahead of it scores a rank-indexed bonus (RANK_BONUS=[0,0,0,20,40,80,160,0]). South-fill of enemy pawn frontspan yields the block mask; passed = my_pawns & !block." ;
    cf:kernelHelpers """use crate::position::PAWN;

/// Rank bonus table (index = rank 0..7). Rank 0 and 7 are impossible for pawns.
const RANK_BONUS: [i32; 8] = [0, 0, 0, 20, 40, 80, 160, 0];

/// Fill all squares south of (and including) occupied bits — produces all
/// squares that can be reached by the pawns moving in their direction.
#[inline]
fn south_fill(mut bb: u64) -> u64 {
    bb |= bb >> 8;
    bb |= bb >> 16;
    bb |= bb >> 32;
    bb
}

/// Enemy block mask: any square on the same or adjacent file blocked by an
/// enemy pawn. For white: marks all squares below black pawns (white pawns in
/// these squares are blocked from advancing).
#[inline]
fn enemy_block(enemy_pawns: u64) -> u64 {
    let fill = south_fill(enemy_pawns);
    // spread one file left and right (within each rank, mask off wrap-around)
    // NOT_FILE_A = 0x7F7F7F7F7F7F7F7Fu64 (clears file 0, keeps files 1-7)
    // NOT_FILE_H = 0xFEFEFEFEFEFEFEFEu64 (clears file 7, keeps files 0-6)
    let left = (fill & 0x7F7F7F7F7F7F7F7Fu64) << 1;    // shift left within ranks (file++)
    let right = (fill & 0xFEFEFEFEFEFEFEFEu64) >> 1;   // shift right within ranks (file--)
    fill | left | right
}

/// Sum passed-pawn bonuses for one color. Loops — private, outside CC=1 boundary.
#[inline]
pub(super) fn passed_score(v: &PositionView, color: usize) -> i32 {
    let rank_bonus = [0i32, 0, 0, 20, 40, 80, 160, 0];
    let mut score = 0i32;

    if color == 0 {
        // White pawns: check if each pawn is passed (no black pawn ahead on same/adj files)
        let mut bb = v.by_piece[WHITE][PAWN];
        while bb != 0 {
            let sq = bb.trailing_zeros() as usize;
            let rank = sq / 8;
            let file = sq % 8;
            let mut blocked = false;

            // Check ranks ahead (north)
            let mut r = rank + 1;
            while r < 8 {
                let bit = 1u64 << (r * 8 + file);
                let left = if file > 0 { 1u64 << (r * 8 + file - 1) } else { 0 };
                let right = if file < 7 { 1u64 << (r * 8 + file + 1) } else { 0 };
                if (v.by_piece[BLACK][PAWN] & (bit | left | right)) != 0 {
                    blocked = true;
                }
                r += 1;
            }

            if !blocked {
                score += rank_bonus[rank];
            }
            bb &= bb - 1;
        }
    } else {
        // Black pawns: check if each pawn is passed (no white pawn ahead on same/adj files)
        let mut bb = v.by_piece[BLACK][PAWN];
        while bb != 0 {
            let sq = bb.trailing_zeros() as usize;
            let rank = 7 - sq / 8;
            let file = sq % 8;
            let mut blocked = false;

            // Check ranks ahead (south)
            let mut r = (sq / 8) as i32 - 1;
            while r >= 0 {
                let bit = 1u64 << (r as usize * 8 + file);
                let left = if file > 0 { 1u64 << (r as usize * 8 + file - 1) } else { 0 };
                let right = if file < 7 { 1u64 << (r as usize * 8 + file + 1) } else { 0 };
                if (v.by_piece[WHITE][PAWN] & (bit | left | right)) != 0 {
                    blocked = true;
                }
                r -= 1;
            }

            if !blocked {
                score += rank_bonus[rank as usize];
            }
            bb &= bb - 1;
        }
    }

    score
}""" ;
    cf:kernelBody """(passed_score(v, WHITE) - passed_score(v, BLACK)).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """let mut white = 0i32;
        let mut black = 0i32;
        let rank_bonus = [0i32, 0, 0, 20, 40, 80, 160, 0];
        let mut bb = v.by_piece[WHITE][crate::position::PAWN];
        while bb != 0 {
            let sq = bb.trailing_zeros() as usize;
            let rank = sq / 8;
            // check no black pawn on same or adjacent files ahead (north)
            let file = sq % 8;
            let mut blocked = false;
            let mut r = rank + 1;
            while r < 8 {
                let bit = 1u64 << (r * 8 + file);
                let left = if file > 0 { 1u64 << (r * 8 + file - 1) } else { 0 };
                let right = if file < 7 { 1u64 << (r * 8 + file + 1) } else { 0 };
                if (v.by_piece[BLACK][crate::position::PAWN] & (bit | left | right)) != 0 {
                    blocked = true;
                }
                r += 1;
            }
            if !blocked {
                white += rank_bonus[rank];
            }
            bb &= bb - 1;
        }
        let mut bb = v.by_piece[BLACK][crate::position::PAWN];
        while bb != 0 {
            let sq = bb.trailing_zeros() as usize;
            let rank = 7 - sq / 8;
            let file = sq % 8;
            let mut blocked = false;
            let mut r = (sq / 8) as i32 - 1;
            while r >= 0 {
                let bit = 1u64 << (r as usize * 8 + file);
                let left = if file > 0 { 1u64 << (r as usize * 8 + file - 1) } else { 0 };
                let right = if file < 7 { 1u64 << (r as usize * 8 + file + 1) } else { 0 };
                if (v.by_piece[WHITE][crate::position::PAWN] & (bit | left | right)) != 0 {
                    blocked = true;
                }
                r -= 1;
            }
            if !blocked {
                black += rank_bonus[rank];
            }
            bb &= bb - 1;
        }
        (white - black) * SCORE_SCALE""" ;
    cf:firedExpr """v.by_piece[WHITE][crate::position::PAWN] | v.by_piece[BLACK][crate::position::PAWN]""" .

cf:rook_open_file a cf:FeatureStation ;
    cf:id 7 ;
    cf:name "rook_open_file" ;
    cf:lowering cf:Mask ;
    cf:primitive "crate::rays::FILE_A" ;
    cf:inputMask "rooks & open_files" ;
    cf:scoreScale 10 ;
    cf:weight_q8 192 ;
    cf:eventCode 1007 ;
    cf:eventName "rook_open_file_evaluated" ;
    cf:authority "raw_cp == sum_rooks(open?25:semi_open?10:0) white minus black" ;
    cf:doc "Rook on open/semi-open file bonus: 25 cp for a fully open file (no pawns of either color), 10 cp for semi-open (no own pawns). White minus black, scaled." ;
    cf:kernelHelpers """use crate::position::{PAWN, ROOK};

/// File-A mask repeated across all 8 files (one bit per rank on file A).
const FILE_A: u64 = 0x0101010101010101u64;

/// Score for all rooks of one color based on open/semi-open file status.
/// Loops over rooks — private, outside CC=1 boundary.
#[inline]
pub(super) fn rook_file_score(v: &PositionView, color: usize) -> i32 {
    let all_pawns = v.by_piece[WHITE][PAWN] | v.by_piece[BLACK][PAWN];
    let own_pawns = v.by_piece[color][PAWN];
    let mut rooks = v.by_piece[color][ROOK];
    let mut score = 0i32;
    while rooks != 0 {
        let sq = rooks.trailing_zeros() as usize;
        let file = sq % 8;
        let file_mask = FILE_A << file;
        let open = (all_pawns & file_mask) == 0;
        let semi_open = (own_pawns & file_mask) == 0;
        score += if open { 25 } else if semi_open { 10 } else { 0 };
        rooks &= rooks - 1;
    }
    score
}""" ;
    cf:kernelBody """(rook_file_score(v, WHITE) - rook_file_score(v, BLACK)).wrapping_mul(SCORE_SCALE)""" ;
    cf:oracleBody """let file_a: u64 = 0x0101010101010101u64;
        let all_pawns = v.by_piece[WHITE][crate::position::PAWN] | v.by_piece[BLACK][crate::position::PAWN];
        let mut white = 0i32;
        let mut black = 0i32;
        let mut rooks = v.by_piece[WHITE][crate::position::ROOK];
        while rooks != 0 {
            let sq = rooks.trailing_zeros() as usize;
            let file_mask = file_a << (sq % 8);
            let open = (all_pawns & file_mask) == 0;
            let semi = (v.by_piece[WHITE][crate::position::PAWN] & file_mask) == 0;
            white += if open { 25 } else if semi { 10 } else { 0 };
            rooks &= rooks - 1;
        }
        let mut rooks = v.by_piece[BLACK][crate::position::ROOK];
        while rooks != 0 {
            let sq = rooks.trailing_zeros() as usize;
            let file_mask = file_a << (sq % 8);
            let open = (all_pawns & file_mask) == 0;
            let semi = (v.by_piece[BLACK][crate::position::PAWN] & file_mask) == 0;
            black += if open { 25 } else if semi { 10 } else { 0 };
            rooks &= rooks - 1;
        }
        (white - black) * SCORE_SCALE""" ;
    cf:firedExpr """v.by_piece[WHITE][crate::position::ROOK] | v.by_piece[BLACK][crate::position::ROOK]""" .

